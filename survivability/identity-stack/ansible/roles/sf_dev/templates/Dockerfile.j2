# Managed by Ansible (sf_dev role). Local edits are overwritten.
FROM {{ sf_dev_base_image }}
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl gnupg sudo git vim nano tmux htop less jq unzip tini locales \
      build-essential python3 python3-pip python3-venv iproute2 iputils-ping dnsutils openssh-client \
 && curl -fsSL https://pkgs.tailscale.com/stable/ubuntu/noble.noarmor.gpg -o /usr/share/keyrings/tailscale-archive-keyring.gpg \
 && curl -fsSL https://pkgs.tailscale.com/stable/ubuntu/noble.tailscale-keyring.list -o /etc/apt/sources.list.d/tailscale.list \
 && apt-get update && apt-get install -y --no-install-recommends tailscale \
 && locale-gen en_US.UTF-8 && rm -rf /var/lib/apt/lists/*
# One shared account; sudo works inside the container only.
RUN (userdel -r ubuntu 2>/dev/null || true) \
 && useradd -M -d /home/dev -s /bin/bash -u 1000 dev \
 && echo 'dev ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/dev && chmod 440 /etc/sudoers.d/dev
ENV LANG=en_US.UTF-8
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 755 /usr/local/bin/entrypoint.sh
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint.sh"]
