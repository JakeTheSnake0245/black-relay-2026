# Managed by Ansible (sf_dev role). Local edits are overwritten.
# sf-dev: Sysbox system container for the Sensor Fusion teams. Boots systemd,
# runs its own Docker (the teams' containers live inside it), reached only over
# the tailnet. Sysbox gives it its own user namespace: root inside is not root
# on this host. No published ports; its own network; sf-dev-guard.service
# blocks metadata and private ranges.
name: sf-dev
services:
  sf-dev:
    image: "{{ sf_dev_image }}"
    pull_policy: never
    container_name: "{{ sf_dev_container }}"
    hostname: "{{ sf_dev_hostname }}"
    runtime: sysbox-runc
    restart: unless-stopped
    devices: ["/dev/net/tun:/dev/net/tun"]
    pids_limit: {{ sf_dev_pids_limit }}
    volumes:
      # Everything that must survive a rebuild is on the disk.
{% for d in sf_dev_system_dirs %}
      - "{{ sf_dev_dir }}/disk/system/{{ d }}:/{{ d }}"
{% endfor %}
      - "{{ sf_dev_dir }}/disk/docker:/var/lib/docker"
      - "{{ sf_dev_dir }}/disk/home:/home"
      - "{{ sf_dev_dir }}/disk/tailscale:/var/lib/tailscale"
    networks:
      {{ sf_dev_network }}: {}
    deploy:
      resources:
        limits: {memory: "{{ sf_dev_memory }}", cpus: "{{ sf_dev_cpus }}"}

networks:
  {{ sf_dev_network }}:
    external: true
    name: "{{ sf_dev_network }}"
