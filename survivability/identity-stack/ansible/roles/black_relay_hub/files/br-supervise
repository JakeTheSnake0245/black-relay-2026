#!/bin/sh
# br-supervise — runs Black Relay tunnels inside the container (no systemd).
#
#   br-supervise          (entrypoint, under tini) run every /etc/black-relay/*.conf
#   br-supervise health   exit 0 if every configured tunnel's device is up
#
# Each <name>.conf is one tunnel, handled by the same helper the .deb uses
# (/usr/lib/black-relay/tunnel check|run|post|down). Configs that appear later
# (`black-relay-hub add <site>` via docker exec) start within ~2 s; a removed
# config stops its tunnel. A tunnel that dies restarts after a short backoff.
#
# Environment:
#   BR_PUBLIC_IP   hub only: public IPv4 written into join tokens (first run);
#                  tunnels are never forwarded to it
#   BR_PORT_BASE   hub only: site N listens on BR_PORT_BASE+N/udp (default 5000)
#   BR_NAT=1       masquerade tunnel traffic leaving the egress interface
#   BR_FORWARD     which forwarding the container allows (inside its own netns):
#                    egress (default)  tunnels -> public internet via the default
#                                      route only: never tunnel <-> tunnel, never
#                                      to private/CGNAT/link-local/special ranges
#                                      (the container's own Docker networks among
#                                      them), never to BR_PUBLIC_IP
#                    none              no forwarding at all (overlay links only)
#   BR_WS_LISTEN   hub only, e.g. 0.0.0.0:8080: also run a wstunnel server so
#                  sites reach their UDP site ports through HTTPS (a reverse
#                  proxy terminates TLS and forwards the WebSocket upgrade here)
#   BR_WS_PREFIX   the secret upgrade-path prefix the server accepts (required
#                  with BR_WS_LISTEN); clients use the same value
#
#   br-supervise publish   (re)apply /etc/black-relay/publish.conf: site services
#                  the reverse proxy may reach at multithread:<port>, one per line
#                  "<hub port> <site ip> <site port>" (TCP). DNAT to the site,
#                  SNAT to the tunnel address so replies return through the tunnel.
#                  Never from a tunnel; only the exact address:port listed, and
#                  only when addressed to BR_PUBLISH_ADDR.
#   BR_PUBLISH_ADDR hub only: this hub's own address on the reverse proxy's
#                  network. Required by publish; without it nothing is published.
#
# The identity snapshot (:8099) answers only each site tunnel's peer address
# (PEER= in its config) arriving on that tunnel's own device.
set -eu

ETC=/etc/black-relay
T=/usr/lib/black-relay/tunnel
RUN=/run/br-supervise
DEFAULTS=/usr/share/black-relay/defaults

log() { echo "br-supervise: $*" >&2; }

tunnels() {
	for c in "$ETC"/*.conf; do
		[ -e "$c" ] || continue
		n=${c##*/}; n=${n%.conf}
		[ "$n" = hub ] && continue
		echo "$n"
	done
}

dev_of() { sed -n 's/^DEV=//p' "$ETC/$1.conf" | head -n 1 | tr -d '"' | awk '{print $1}'; }

# Only these invocations exist. Anything else used to fall through to the
# entrypoint and start a second supervisor fighting the first over the tunnels.
case "${1:-}" in
	''|health|publish) ;;
	*) log "unknown command: $1 (use: health, publish)"; exit 2 ;;
esac

# Fails closed: without BR_PUBLISH_ADDR nothing is published. Only the
# destination can be pinned: Caddy has no fixed address on the proxy network,
# so any container there can reach a published service; the service's own
# sign-in is what gates it.
publish() {
	nft delete table inet br_publish 2>/dev/null || true
	[ -s "$ETC/publish.conf" ] || return 0
	addr=${BR_PUBLISH_ADDR:-}
	case "$addr" in
		''|*[!0-9.]*) log "publish: BR_PUBLISH_ADDR is not an IPv4 address; nothing published"; return 1 ;;
	esac
	pre=''
	while read -r hp ip sp _; do
		case "$hp" in ''|\#*) continue ;; esac
		case "$hp$sp" in *[!0-9]*) log "publish: bad port in '$hp $ip $sp'"; continue ;; esac
		case "$ip" in *[!0-9.]*|'') log "publish: bad address '$ip'"; continue ;; 10.*.*.*) ;; *) log "publish: site address must be 10.x: '$ip'"; continue ;; esac
		[ "$hp" -ge 1 ] && [ "$hp" -le 65535 ] && [ "$sp" -ge 1 ] && [ "$sp" -le 65535 ] || continue
		pre="$pre
		ip daddr $addr iifname != \"br*\" tcp dport $hp dnat ip to $ip:$sp"
	done < "$ETC/publish.conf"
	[ -n "$pre" ] || return 0
	nft -f - <<EOF
table inet br_publish {
	chain pre {
		type nat hook prerouting priority dstnat; policy accept;$pre
	}
	chain post {
		type nat hook postrouting priority srcnat; policy accept;
		oifname "br*" ct status dnat masquerade
	}
}
EOF
	log "published: $(grep -cvE '^[[:space:]]*(#|$)' "$ETC/publish.conf") site service(s)"
}

if [ "${1:-}" = publish ]; then
	publish
	exit 0
fi

if [ "${1:-}" = health ]; then
	rc=0
	for n in $(tunnels); do
		d=$(dev_of "$n"); [ -n "$d" ] || d=br-$n
		ip link show dev "$d" >/dev/null 2>&1 || { echo "down: $n ($d)"; rc=1; }
	done
	exit $rc
fi

mkdir -p "$ETC" "$RUN"
chmod 700 "$ETC"
[ -e "$ETC/black-relay.env" ] || cp "$DEFAULTS/black-relay.env" "$ETC/black-relay.env"
if [ -n "${BR_PUBLIC_IP:-}" ] && [ ! -e "$ETC/hub.conf" ]; then
	black-relay-hub init --public-ip "$BR_PUBLIC_IP" --port-base "${BR_PORT_BASE:-5000}"
fi

# Forwarding + NAT live in the container's own network namespace; the host's
# kernel and firewall are not touched. Deny by default. The egress interface
# is the one holding the default route (with several Docker networks attached,
# eth0 is not necessarily it).
EGRESS=$(ip -4 route show default | awk '{for (n = 1; n < NF; n++) if ($n == "dev") {print $(n + 1); exit}}')
[ -n "$EGRESS" ] || EGRESS=eth0
# Never forwarded to: this-network, private, CGNAT, loopback, link-local,
# IETF protocol assignments, benchmarking, multicast and reserved.
EXCLUDED='{ 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.168.0.0/16, 198.18.0.0/15, 224.0.0.0/3 }'
# This host's own public address: only its public web services (80/443:
# Headscale, Pocket ID, the site lanes) - the same as from the internet. Every
# other port would reach host services from a Docker network instead.
own=''
case "${BR_PUBLIC_IP:-}" in
	''|*[!0-9.]*) ;;
	*) own="iifname \"br*\" ip daddr $BR_PUBLIC_IP tcp dport { 80, 443 } accept
		iifname \"br*\" ip daddr $BR_PUBLIC_IP drop" ;;
esac
case "${BR_FORWARD:-egress}" in
	egress) fwd="iifname \"br*\" oifname \"$EGRESS\" ip daddr != $EXCLUDED accept" ;;
	none) fwd='' ;;
	*) log "BR_FORWARD must be egress or none"; exit 1 ;;
esac
nat=''
[ "${BR_NAT:-1}" = 1 ] && nat="chain br_postrouting { type nat hook postrouting priority srcnat; policy accept; oifname \"$EGRESS\" masquerade; }"
nft delete table inet br 2>/dev/null || true
nft -f - <<EOF
table inet br {
	# identity snapshot: each site's own peer address on its own tunnel
	# device (filled by id_peers); everyone else is dropped
	set id_peers {
		type ifname . ipv4_addr
	}
	chain br_input {
		type filter hook input priority filter; policy accept;
		tcp dport 8099 iifname . ip saddr @id_peers accept
		tcp dport 8099 drop
	}
	chain br_forward {
		type filter hook forward priority filter; policy drop;
		ct state invalid drop
		ct state { established, related } accept
		# published site services (br_publish DNAT; nothing else DNATs here)
		iifname != "br*" oifname "br*" ct status dnat accept
		$own
		$fwd
	}
	$nat
}
EOF
rm -f "$RUN/id_peers"
log "forwarding: ${BR_FORWARD:-egress} via $EGRESS, nat: ${BR_NAT:-1}"
publish || true

# wstunnel server (HTTPS transport for sites). It may only forward to this
# hub's own site ports on loopback, and only for the secret path prefix.
ws_start() {
	[ -n "${BR_WS_LISTEN:-}" ] || return 0
	[ -n "${BR_WS_PREFIX:-}" ] || { log "BR_WS_LISTEN needs BR_WS_PREFIX"; return 0; }
	pid=$(cat "$RUN/wstunnel.ws" 2>/dev/null || true)
	[ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && return 0
	. "$ETC/hub.conf" 2>/dev/null || true
	base=${PORT_BASE:-${BR_PORT_BASE:-5000}}
	# the prefix is a secret: environment, not argv (argv shows up in ps/top)
	export WSTUNNEL_RESTRICT_HTTP_UPGRADE_PATH_PREFIX="$BR_WS_PREFIX"
	set --
	i=1
	while [ $i -le "${BR_WS_SITES:-10}" ]; do
		set -- "$@" --restrict-to "127.0.0.1:$((base + i))"
		i=$((i + 1))
	done
	wstunnel server --log-lvl "${BR_WS_LOG:-INFO}" "$@" "ws://$BR_WS_LISTEN" &
	echo $! >"$RUN/wstunnel.ws"   # not *.pid: those are tunnels
	log "wstunnel server on $BR_WS_LISTEN -> 127.0.0.1:$((base + 1))-$((base + ${BR_WS_SITES:-10}))/udp (pid $!)"
}

start() {
	n=$1
	if ! "$T" check "$n" 2>"$RUN/$n.err"; then
		# log a bad config once, not every loop
		cmp -s "$RUN/$n.err" "$RUN/$n.lasterr" 2>/dev/null || { cat "$RUN/$n.err" >&2; cp "$RUN/$n.err" "$RUN/$n.lasterr"; }
		return 0
	fi
	rm -f "$RUN/$n.lasterr"
	"$T" run "$n" &
	pid=$!
	echo "$pid" >"$RUN/$n.pid"
	date +%s >"$RUN/$n.started"
	( "$T" post "$n" >&2 || { log "$n: post failed, restarting"; kill "$pid" 2>/dev/null; } ) &
	log "$n: started (pid $pid)"
}

stop() {
	n=$1
	pid=$(cat "$RUN/$n.pid" 2>/dev/null || true)
	[ -n "$pid" ] && kill "$pid" 2>/dev/null || true
	[ -e "$ETC/$n.conf" ] && "$T" down "$n" 2>/dev/null || true
	rm -f "$RUN/$n.pid" "$RUN/$n.started"
	log "$n: stopped"
}

# Data-plane watchdog (per site): lanes can be "running" while data is wedged.
# Every ~10 s ping the site's overlay address through its tunnel; after 3
# straight failures while that site has running paths, restart its glorytun
# (fresh keys, new receive state). Sites with no running paths are skipped:
# that is an outage, not a wedge.
wd_check() {
	n=$1
	peer=$(sed -n 's/^PEER=//p' "$ETC/$n.conf" | head -n 1 | tr -d '"')
	[ -n "$peer" ] || return 0
	d=$(dev_of "$n"); [ -n "$d" ] || d=br-$n
	if ping -c 1 -W 2 -I "$d" "$peer" >/dev/null 2>&1; then
		echo 0 >"$RUN/$n.wd"; return 0
	fi
	running=$(/usr/lib/black-relay/glorytun path dev "$d" show 2>/dev/null | grep -c " running ")
	[ "$running" -gt 0 ] || { echo 0 >"$RUN/$n.wd"; return 0; }
	f=$(( $(cat "$RUN/$n.wd" 2>/dev/null || echo 0) + 1 ))
	echo "$f" >"$RUN/$n.wd"
	log "$n: site $peer not answering through the tunnel ($f/3, $running paths running)"
	if [ "$f" -ge 3 ]; then
		log "$n: data plane wedged: restarting its glorytun"
		kill "$(cat "$RUN/$n.pid" 2>/dev/null)" 2>/dev/null || true
		echo -6 >"$RUN/$n.wd"   # ~60 s grace before counting again
	fi
}

shutdown() {
	kill "$(cat "$RUN/wstunnel.ws" 2>/dev/null)" 2>/dev/null || true
	kill "$(cat "$RUN/identity.ws" 2>/dev/null)" 2>/dev/null || true
	for p in "$RUN"/*.pid; do
		[ -e "$p" ] || continue
		n=${p##*/}; stop "${n%.pid}"
	done
	exit 0
}
trap shutdown TERM INT

# Who may fetch the identity snapshot: each tunnel's peer (the site end of the
# overlay, PEER= in its config) arriving on that tunnel's device. A device
# behind a site's edge keeps its own LAN source address and is dropped. The
# set is rewritten only when the site configs change.
id_peers() {
	els=''
	for n in $(tunnels); do
		peer=$(sed -n 's/^PEER=//p' "$ETC/$n.conf" | head -n 1 | tr -d '"')
		d=$(dev_of "$n"); [ -n "$d" ] || d=br-$n
		case "$peer" in ''|*[!0-9.]*) continue ;; esac
		case "$d" in *[!A-Za-z0-9_.-]*) continue ;; esac
		els="$els${els:+, }\"$d\" . $peer"
	done
	[ "$els" = "$(cat "$RUN/id_peers" 2>/dev/null || true)" ] && return 0
	if {
		echo "flush set inet br id_peers"
		[ -z "$els" ] || echo "add element inet br id_peers { $els }"
	} | nft -f -; then
		printf '%s\n' "$els" >"$RUN/id_peers"
		log "identity snapshot allowed from: ${els:-no site}"
	else
		log "identity snapshot: could not update the allowed site peers"
	fi
}

# Identity/policy snapshot for sites (written by br-identity-export on the
# host), served read-only on :8099, reachable only by the site peers above.
id_start() {
	[ -e "$ETC/identity-snapshot.json" ] || return 0
	pid=$(cat "$RUN/identity.ws" 2>/dev/null || true)
	[ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && return 0
	python3 - "$ETC/identity-snapshot.json" <<'PY' &
import http.server, sys
F = sys.argv[1]
class H(http.server.BaseHTTPRequestHandler):
    def log_message(self, *a): pass
    def do_GET(self):
        if self.path != "/identity.json":
            self.send_response(404); self.end_headers(); return
        try: b = open(F, "rb").read()
        except OSError: self.send_response(503); self.end_headers(); return
        self.send_response(200); self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(b))); self.end_headers(); self.wfile.write(b)
http.server.ThreadingHTTPServer(("0.0.0.0", 8099), H).serve_forever()
PY
	echo $! >"$RUN/identity.ws"
	log "identity snapshot served on :8099 (site tunnel peers only)"
}

wd_tick=0
while :; do
	id_peers
	id_start
	now=$(date +%s)
	ws_start
	wd_tick=$((wd_tick + 1))
	if [ "$wd_tick" -ge 5 ]; then
		wd_tick=0
		for n in $(tunnels); do
			[ -e "$RUN/$n.pid" ] && wd_check "$n"
		done
	fi
	for n in $(tunnels); do
		pid=$(cat "$RUN/$n.pid" 2>/dev/null || true)
		if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then continue; fi
		if [ -n "$pid" ]; then
			wait "$pid" 2>/dev/null || true
			log "$n: exited"
			"$T" down "$n" 2>/dev/null || true
			rm -f "$RUN/$n.pid"
		fi
		last=$(cat "$RUN/$n.started" 2>/dev/null || echo 0)
		[ $((now - last)) -ge 3 ] && start "$n"
	done
	for p in "$RUN"/*.pid; do
		[ -e "$p" ] || continue
		n=${p##*/}; n=${n%.pid}
		[ -e "$ETC/$n.conf" ] || stop "$n"
	done
	sleep 2 &
	wait $! || true
done
