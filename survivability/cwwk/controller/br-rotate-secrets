#!/bin/bash
# br-rotate-secrets: new Proxmox API token secret for the controller and a new
# br-router root password. Updates the controller config and the root-only copies
# in /root/black-relay/, then checks the controller can still reach both.
# Never prints a secret. Run on the CWWK host as root.
set -euo pipefail
umask 077
D=/root/black-relay CT_ROUTER=102 CT_CTRL=103 TOKEN_USER=br-controller@pve TOKEN=ui
setcfg() {   # key.path, value on stdin
	pct exec $CT_CTRL -- python3 -c '
import json, os, sys
keys = sys.argv[1].split("."); v = sys.stdin.read()
p = "/etc/br-controller/config.json"; c = json.load(open(p)); d = c
for k in keys[:-1]:
    d = d[k]
d[keys[-1]] = v
t = p + ".tmp"; fd = os.open(t, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
os.write(fd, json.dumps(c, indent=2).encode()); os.close(fd); os.replace(t, p)' "$1"
}

# Proxmox token: same role (BlackRelayController on /), new secret
roles=$(pveum acl list --output-format json | python3 -c "import json,sys; print(','.join(a['roleid'] for a in json.load(sys.stdin) if a['ugid'] == '$TOKEN_USER!$TOKEN' and a['path'] == '/'))")
[ -n "$roles" ] || roles=BlackRelayController
pveum user token remove $TOKEN_USER $TOKEN >/dev/null
pveum user token add $TOKEN_USER $TOKEN --privsep 1 --output-format json >$D/.pve-token.new
pveum acl modify / --tokens "$TOKEN_USER!$TOKEN" --roles "$roles" --propagate 1
mv $D/.pve-token.new $D/pve-token.json
python3 -c "import json; print(json.load(open('$D/pve-token.json'))['value'], end='')" | setcfg proxmox.token_secret
echo "Proxmox token rotated ($TOKEN_USER!$TOKEN, role $roles)"

# br-router root password
pw=$(head -c 24 /dev/urandom | base64 | tr -d '+/=' | cut -c1-24)
printf '%s\n%s\n' "$pw" "$pw" | pct exec $CT_ROUTER -- passwd root >/dev/null 2>&1
printf '%s\n' "$pw" >$D/router-root.pw
printf '%s' "$pw" | setcfg router.password
unset pw
echo "router root password rotated (copy: $D/router-root.pw)"

pct exec $CT_CTRL -- systemctl restart br-controller
sleep 3
pct exec $CT_CTRL -- sh -c 'cd /opt/br-controller && python3 -c "
import app
s = app.poll_once(app.Proxmox(app.CONF[\"proxmox\"]), app.Router(app.CONF[\"router\"]))
for k in (\"compute\", \"network\"):
    print(k, s[\"subsystems\"][k][\"level\"])
"'
