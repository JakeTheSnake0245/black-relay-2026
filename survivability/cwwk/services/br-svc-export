#!/usr/bin/env python3
"""br-svc-export: pack one sf-dev compose project into a bundle a CWWK site can run offline.

Runs ON sf-dev (as dev). svc-sync.sh pipes it over SSH, so nothing is installed there:

    python3 - NAME ROOT WORKDIR COMPOSE[,COMPOSE...] [--profiles a,b] [--card JSON] [--out DIR] [--version-only]

  NAME     bundle / service name (e.g. rf-central)
  ROOT     project root; the whole tree goes in (minus .git, .env, caches), because compose
           files reference siblings (../console/site, ../analytics/config)
  WORKDIR  folder under ROOT where `docker compose` runs (e.g. central)
  COMPOSE  compose files, in order, relative to WORKDIR

The bundle (one .tar): manifest.json, project.tar.gz, images.tar.gz (docker save of every image
the project uses, so the site needs no registry and no internet), SHA256SUMS.
VERSION = hash of every image ID + every project file. Same code + same images = same version,
which is what the drift check compares. No secrets go in: .env is excluded; the site makes its own.
"""
import argparse, hashlib, json, os, subprocess, sys, tarfile, tempfile, time

EXCLUDE_DIRS = {".git", "node_modules", ".venv", "__pycache__", ".pytest_cache", ".mypy_cache", "captures", "logs"}
EXCLUDE_FILES = {".env"}


def die(msg):
    print("STOP: " + msg, file=sys.stderr)
    sys.exit(1)


def run(cmd, cwd=None, **kw):
    p = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, **kw)
    if p.returncode:
        die("%s: %s" % (" ".join(cmd[:4]), (p.stderr or p.stdout).strip()[-400:]))
    return p.stdout


def project_files(root):
    out = []
    for d, dirs, files in os.walk(root):
        dirs[:] = sorted(x for x in dirs if x not in EXCLUDE_DIRS)
        for f in sorted(files):
            if f in EXCLUDE_FILES or f.endswith((".pyc", ".log")):
                continue
            out.append(os.path.join(d, f))
    return out


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for b in iter(lambda: fh.read(1 << 20), b""):
            h.update(b)
    return h.hexdigest()


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("name"); ap.add_argument("root"); ap.add_argument("workdir"); ap.add_argument("compose")
    ap.add_argument("--profiles", default=""); ap.add_argument("--card", default="")
    ap.add_argument("--out", default=os.path.expanduser("~/br-bundles")); ap.add_argument("--version-only", action="store_true")
    a = ap.parse_args()
    root = os.path.realpath(a.root)
    work = os.path.join(root, a.workdir)
    compose = a.compose.split(",")
    profiles = [p for p in a.profiles.split(",") if p]
    for f in compose:
        if not os.path.isfile(os.path.join(work, f)):
            die("compose file not found: %s" % os.path.join(work, f))

    cmd = ["docker", "compose"] + sum([["-f", f] for f in compose], []) + sum([["--profile", p] for p in profiles], []) + ["config", "--images"]
    images = sorted(set(run(cmd, cwd=work).split()))
    if not images:
        die("compose lists no images")
    info = []
    for img in images:
        p = subprocess.run(["docker", "image", "inspect", "--format", "{{.Id}}", img], capture_output=True, text=True)
        if p.returncode:
            die("image %s is not on this box: build it first (cd %s && docker compose %s build)" % (img, work, " ".join(sum([["--profile", x] for x in profiles], []))))
        info.append({"name": img, "id": p.stdout.strip()})

    files = project_files(root)
    h = hashlib.sha256()
    for i in info:
        h.update((i["name"] + i["id"]).encode())
    for f in files:
        h.update(os.path.relpath(f, root).encode()); h.update(sha256(f).encode())
    version = h.hexdigest()[:12]
    if a.version_only:
        print(version)
        return

    os.makedirs(a.out, exist_ok=True)
    bundle = os.path.join(a.out, "%s-%s.tar" % (a.name, version))
    with tempfile.TemporaryDirectory() as t:
        proj = os.path.join(t, "project.tar.gz")
        with tarfile.open(proj, "w:gz") as tf:
            for f in files:
                tf.add(f, arcname=os.path.relpath(f, root), recursive=False)
        imgs = os.path.join(t, "images.tar.gz")
        subprocess.run("docker save %s | gzip -1 > %s" % (" ".join(images), imgs), shell=True, check=True)
        man = {"name": a.name, "version": version, "created": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "source": os.uname().nodename,
               "workdir": a.workdir, "compose": compose, "profiles": profiles, "images": info,
               "card": json.loads(a.card) if a.card else None}
        with open(os.path.join(t, "manifest.json"), "w") as fh:
            json.dump(man, fh, indent=2)
        with open(os.path.join(t, "SHA256SUMS"), "w") as fh:
            for n in ("manifest.json", "project.tar.gz", "images.tar.gz"):
                fh.write("%s  %s\n" % (sha256(os.path.join(t, n)), n))
        with tarfile.open(bundle + ".part", "w") as tf:
            for n in ("manifest.json", "project.tar.gz", "images.tar.gz", "SHA256SUMS"):
                tf.add(os.path.join(t, n), arcname=n)
    os.replace(bundle + ".part", bundle)
    # keep only the newest two bundles of this name
    olds = sorted((os.path.join(a.out, f) for f in os.listdir(a.out) if f.startswith(a.name + "-") and f.endswith(".tar")), key=os.path.getmtime)
    for o in olds[:-2]:
        os.unlink(o)
    print("BUNDLE %s VERSION %s SIZE %d" % (bundle, version, os.path.getsize(bundle)))


main()
