# Black Relay glorytun fork — runtime switches.
#
# Read by glorytun-br (the wrapper OMR runs after `black-relay-switch fork`)
# and by black-relay@<name>.service. A tunnel's own /etc/black-relay/<name>.conf
# may override any of these for that tunnel only.
#
# Both directions are independent: the scheduler acts on what this end SENDS,
# the resequencer on what it RECEIVES. Setting all of them on both ends gives
# scatter + reconstruct in both directions.
#
# MUST MATCH ON BOTH ENDS: GT_HP. Both ends must also run the fork itself
# (the data wire format carries an 8-byte in-AEAD sequence number).

# Sender scheduler:
#   scatter  consecutive packets round-robin across links (max disorder on wire)
#   arrival  earliest predicted arrival (lowest latency; best for CoT, but
#            at light load it keeps everything on the fastest link, so the
#            wire shows little disorder)
#   random   stock glorytun weighted-random
GT_SCHED=scatter

# Scatter only onto lanes whose one-way delay trails the fastest by at most
# this many ms; a lane outside it (handoff spike, congested cell) is skipped
# until it recovers, instead of losing its share. Default 60 % of GT_RESEQ_MS.
# With it, scatter rides out a 250 ms Starlink spike (see RESULTS.md).
#GT_SCATTER_BUDGET_MS=90

# Receive-side resequencer: release packets to the tun device in order.
GT_RESEQ=1
# Max hold on a gap, ms. With scatter it must exceed (slowest link one-way
# delay - fastest link one-way delay + 2x jitter), or stragglers on the slow
# link are dropped as lost. Lab lanes (20/45/60 ms, cell +-25 ms jitter),
# 500 pkt/s, everything in order (ooo 0) in every row:
#   scatter  50 ms -> 21 % loss       scatter 150 ms -> 0.05 % loss, p50 42 ms
#   scatter 100 ms -> 0.35 % loss     arrival  50 ms -> 0 % loss,    p50 5 ms
# Starlink handoff spike (250 ms +-80): plain round-robin scatter lost 34 %;
# the scatter budget below now skips the spiking lane instead.
# Re-measure on the real links with relay-probe and tune.
GT_RESEQ_MS=150
# Reorder window, packets (clamped to 65536).
GT_RESEQ_WIN=1024

# Header protection: mask the timestamp/nonce field on the wire. Both ends.
GT_HP=1

# FEC XOR parity: 0 = off, N >= 2 = one parity per N packets, auto = adapt N
# from measured forward loss (32 / 16 / 8 / 4 / 2 as loss rises).
GT_FEC=auto

# This end's role: client (site/edge) or server (hub). Keeps the two ends'
# control-message nonces apart under the shared key. black-relay@ tunnels set
# it from ROLE; OMR installs: the .ipk ships client, set server on the OMR
# server. Any combination still interoperates.
#GT_ROLE=

# Client only: idle keepalive per path, ms (stock 25000). Must stay under the
# hub's ~500 ms "waiting" threshold, or an idle lane drops out of the hub's
# mix (download) until upload traffic happens to use it. Each path then sends
# ~1000/GT_KEEPALIVE_MS small packets a second while idle; mind metered
# cellular. Unset = stock.
#GT_KEEPALIVE_MS=200
