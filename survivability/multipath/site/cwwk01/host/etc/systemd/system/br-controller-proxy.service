[Unit]
Description=Black Relay controller on the tailnet (100.64.0.11:443 -> br-controller 10.40.0.10:443)
After=tailscaled.service network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/socat TCP-LISTEN:443,bind=100.64.0.11,reuseaddr,fork TCP:10.40.0.10:443
Restart=always
RestartSec=3
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
