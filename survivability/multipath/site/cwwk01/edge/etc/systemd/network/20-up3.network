# Uplink up3 (CWWK nic3): whatever modem is plugged in (any port takes any modem;
# br-uplinks recognises it and sets its caps). DHCP gives the address and default
# gateway only: routes a modem pushes (option 121/33) are ignored, so a hostile
# modem can't steer site traffic.
[Match]
Name=up3

[Network]
DHCP=ipv4
IPv6AcceptRA=no
LinkLocalAddressing=no

[DHCPv4]
RouteMetric=103
UseRoutes=no
UseGateway=yes
UseDNS=no
UseNTP=no
UseHostname=no
SendHostname=no
