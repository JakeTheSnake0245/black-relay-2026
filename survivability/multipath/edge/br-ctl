#!/bin/sh
# br-ctl — the only commands the CWWK controller may run on the multipath box
# (forced command for its SSH key). Every argument is validated.
set -euf   # -f: no globbing of the forced command's words
CONF=/etc/black-relay/br0.conf
CARRIERS=/etc/black-relay/carriers.conf
ENV=/etc/black-relay/black-relay.env
set -- ${SSH_ORIGINAL_COMMAND:-${*:-help}}
verb=${1:-help}; shift || true
setkv() {  # file key value
	if grep -q "^$2=" "$1"; then sed -i "s|^$2=.*|$2=$3|" "$1"; else printf '%s=%s\n' "$2" "$3" >>"$1"; fi
}
log() { logger -t br-ctl "$*"; }
case "$verb" in
	status)
		python3 - "$ENV" "$CONF" "$CARRIERS" "$(systemctl is-active black-relay@br0)" <<'PY'
import json, re, sys
env, conf, carriers, svc = sys.argv[1:]
def kv(path):
    out = {}
    for line in open(path):
        line = line.split("#", 1)[0].strip()
        if "=" in line:
            k, v = line.split("=", 1)
            out[k.strip()] = v.strip().strip('"')
    return out
e, c, caps, seen = kv(env), kv(conf), [], set()
for line in open(carriers):
    f = line.split("#", 1)[0].split()
    if len(f) >= 3 and f[0] not in seen and re.fullmatch(r"\d+/\d+", f[2]):
        seen.add(f[0]); caps.append(f"{f[0]}:{f[2]}")
print(json.dumps({"sched": e.get("GT_SCHED", ""), "hold": e.get("GT_RESEQ_MS", ""), "lanes": c.get("WSS_LANES", ""),
                  "uplinks": c.get("UPLINKS", ""), "transport": c.get("TRANSPORT", ""), "fec": e.get("GT_FEC", ""),
                  "service": svc, "caps": " ".join(caps)}))
PY
		;;
	set-sched)
		case "${1:-}" in random|arrival|scatter) ;; *) echo "sched: random|arrival|scatter" >&2; exit 2 ;; esac
		setkv $ENV GT_SCHED "$1"; log "sched=$1"; echo "ok (applies on restart-tunnel)" ;;
	set-hold)
		case "${1:-}" in ''|*[!0-9]*) echo "hold: 50-2000 ms" >&2; exit 2 ;; esac
		[ "$1" -ge 50 ] && [ "$1" -le 2000 ] || { echo "hold: 50-2000 ms" >&2; exit 2; }
		setkv $ENV GT_RESEQ_MS "$1"; log "hold=$1"; echo "ok (applies on restart-tunnel)" ;;
	set-lanes)
		case "${1:-}" in [1-6]) ;; *) echo "lanes: 1-6" >&2; exit 2 ;; esac
		setkv $CONF WSS_LANES "$1"; log "lanes=$1"; echo "ok (applies on restart-tunnel)" ;;
	set-caps)
		# per device, not per port: KIND:TX/RX ... (kinds from carriers.conf)
		[ $# -ge 1 ] || { echo "caps: KIND:TX/RX ... (kinds in carriers.conf, e.g. isp starlink spitz)" >&2; exit 2; }
		for kv in "$@"; do
			echo "$kv" | grep -qE '^[a-z][a-z0-9_-]{0,15}:[1-9][0-9]{0,3}/[1-9][0-9]{0,3}$' ||
				{ echo "caps: KIND:TX/RX ... (Mbit)" >&2; exit 2; }
			k=${kv%%:*}; c=${kv#*:}
			grep -qE "^$k[[:space:]]" $CARRIERS || { echo "caps: unknown kind $k" >&2; exit 2; }
		done
		for kv in "$@"; do
			k=${kv%%:*}; c=${kv#*:}
			sed -i -E "s|^($k[[:space:]]+[^[:space:]]+[[:space:]]+)[0-9]+/[0-9]+|\1$c|" $CARRIERS
		done
		/usr/local/sbin/br-uplinks apply >/dev/null
		log "caps=$*"; echo "ok (applies on restart-tunnel)" ;;
	units)
		# read-only: the edge's own services, for the controller's health page
		python3 - <<'PY'
import json, subprocess
def run(*a):
    return subprocess.run(a, capture_output=True, text=True, timeout=5).stdout
names = ["black-relay@br0", "black-relay-watch@br0", "br-uplinks-recheck.timer", "br-lane-nurse", "br-watchdog", "br-dash",
         "dnsmasq", "nftables", "systemd-networkd"]
units = {n: (run("systemctl", "is-active", n).strip() or "unknown") for n in names}
lanes = [l.split() for l in run("systemctl", "list-units", "--all", "--type=service", "--no-legend",
                                 "--plain", "black-relay-lane-*").splitlines() if l.strip()]
print(json.dumps({"units": units, "lanes_total": len(lanes),
                  "lanes_running": sum(1 for l in lanes if len(l) > 3 and l[3] == "running")}))
PY
		;;
	uplinks)
		# what is plugged into each port (written before every tunnel start)
		cat /run/black-relay/uplinks.json 2>/dev/null || /usr/local/sbin/br-uplinks ;;
	restart-tunnel)
		log "restart-tunnel"; systemctl restart --no-block black-relay@br0; echo "restarting" ;;
	selftest)
		exec python3 /usr/local/sbin/br-selftest ;;
	spitz)
		# local management reachability of the Spitz (never the internet)
		python3 - <<'PY'
import json, socket
try:
    ups = json.load(open("/run/black-relay/uplinks.json"))["uplinks"]
except Exception:
    ups = []
sp = next((u for u in ups if u.get("kind") == "spitz" and u.get("admin")), {})
ok = False
if sp:
    try:
        socket.create_connection((sp["admin"][0], 443), 3).close()
        ok = True
    except OSError:
        pass
print(json.dumps({"reachable": ok, "port": sp.get("port", "")}))
PY
		;;
	*) echo "verbs: status set-sched set-hold set-lanes set-caps restart-tunnel spitz uplinks units selftest" >&2; exit 2 ;;
esac
