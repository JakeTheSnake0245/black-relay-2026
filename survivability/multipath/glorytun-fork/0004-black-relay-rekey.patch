+    /* Black Relay: a rotation must also re-derive "next" from the new secret
+     * and the peer's (unchanged) public key. Without it the peer derives the
+     * new key from our new public key and switches to it, while this side
+     * still holds the old "next": nothing the peer sends decrypts any more
+     * until a watchdog restarts the tunnel (cwwk01: every 60 min after the
+     * hub process started). Until a packet under the new key arrives, keep
+     * sending under the current key, so the peer is never ahead of itself. */
+    if (!sodium_is_zero(kx->remote, sizeof(kx->remote))) {
+        unsigned char remote[MUD_PUBKEY_SIZE];
+        memcpy(remote, kx->remote, sizeof(remote));
+        if (!mud_keyx(kx, remote, kx->current.aes)) {
+            kx->wait_peer = 1;
+            kx->use_next = 0;
+        }
+        sodium_memzero(remote, sizeof(remote));
+    }
     kx->time = now;
 
     return 0;
