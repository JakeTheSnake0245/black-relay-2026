+/* Black Relay: anti-replay check over the decrypted sequence number.
+ * Returns 1 if seq is fresh (and records it), 0 if it is a replay or too
+ * old. Tolerates out-of-order arrival within MUD_REPLAY_BITS. */
+static int
+mud_replay_ok(struct mud *mud, uint64_t seq)
+{
+    if (!mud->rw_init) {
+        mud->rw_init = 1;
+        mud->rw_max = seq;
+        memset(mud->rw_bits, 0, sizeof(mud->rw_bits));
+        mud->rw_bits[(seq / 64) % MUD_REPLAY_WORDS] = UINT64_C(1) << (seq % 64);
+        return 1;
+    }
+    if (seq > mud->rw_max) {
+        uint64_t diff = seq - mud->rw_max;
+        if (diff >= MUD_REPLAY_BITS) {
+            memset(mud->rw_bits, 0, sizeof(mud->rw_bits));
+        } else {
+            for (uint64_t s = mud->rw_max + 1; s <= seq; s++)
+                mud->rw_bits[(s / 64) % MUD_REPLAY_WORDS] &=
+                    ~(UINT64_C(1) << (s % 64));
+        }
+        mud->rw_max = seq;
+        mud->rw_bits[(seq / 64) % MUD_REPLAY_WORDS] |= UINT64_C(1) << (seq % 64);
+        return 1;
+    }
+    if (mud->rw_max - seq >= MUD_REPLAY_BITS)
+        return 0;                              /* older than the window */
+
+    uint64_t *w = &mud->rw_bits[(seq / 64) % MUD_REPLAY_WORDS];
+    uint64_t bit = UINT64_C(1) << (seq % 64);
+    if (*w & bit)
+        return 0;                              /* already seen: replay */
+    *w |= bit;
+    return 1;
+}
+
+/* Black Relay: header protection. XOR-masks the 6-byte timestamp field with
+ * a keyed mask derived from a 16-byte ciphertext sample. XOR is its own
+ * inverse, so the same call masks (sender) and unmasks (receiver). Applied
+ * to every packet (data and control) uniformly, before the MSG/nonce fields
+ * are read. No-op if the packet is too small to carry a sample. */
+static void
+mud_hp_apply(struct mud *mud, unsigned char *packet, size_t size)
+{
+    if (!mud->hp_on || size < MUD_TIME_SIZE + 16)
+        return;
+
+    unsigned char mask[crypto_generichash_BYTES_MIN];
+    crypto_generichash(mask, sizeof(mask),
+                       packet + MUD_TIME_SIZE, 16,
+                       mud->hp_key, sizeof(mud->hp_key));
+
+    for (unsigned i = 0; i < MUD_TIME_SIZE; i++)
+        packet[i] ^= mask[i];
+}
+
+/* Black Relay: earliest-predicted-arrival selection.
+ *
+ * For each running path, estimate when a packet of `size` bytes queued now
+ * would arrive at the far end:
+ *
+ *     arrival = owd + (backlog + size) / rate
+ *
+ * owd is taken as rtt/2 (us). backlog is the bytes already queued on the
+ * path, drained at the path's rate since it was last touched. The path with
+ * the smallest arrival wins, and `size` is added to its backlog. When the
+ * network is idle every path's backlog is ~0, so the lowest-owd (fastest)
+ * path is chosen and nothing is reordered; under load the fast path's
+ * backlog grows until a slower path becomes the earlier delivery. No path
+ * is ever excluded. All integer math; time in us, rate in bytes/s. */
+static struct mud_path *
+mud_select_path_arrival(struct mud *mud, uint64_t now, size_t size)
+{
+    struct mud_path *best = NULL;
+    uint64_t best_score = 0;
+
+    for (unsigned i = 0; i < mud->capacity; i++) {
+        struct mud_path *path = &mud->paths[i];
+
+        if (path->status != MUD_RUNNING || !path->tx.rate)
+            continue;
+
+        uint64_t elapsed = MUD_TIME_MASK(now - path->backlog_time);
+        uint64_t drained = path->tx.rate * elapsed / MUD_ONE_SEC;
+
+        path->backlog = (path->backlog > drained) ? path->backlog - drained : 0;
+        path->backlog_time = now;
+
+        uint64_t owd = path->rtt.val ? path->rtt.val / 2 : 0;
+        uint64_t queue_us = (path->backlog + size) * MUD_ONE_SEC / path->tx.rate;
+        uint64_t score = owd + queue_us;
+
+        if (!best || score < best_score) {
+            best = path;
+            best_score = score;
+        }
+    }
+    if (best) {
+        best->backlog += size;
+        best->backlog_time = now;
+    }
+    return best;
+}
+
+/* Black Relay: scatter selection — maximise egress disorder.
+ *
+ * Consecutive sequence numbers are sent round-robin across the running
+ * paths, ignoring rate weighting. With links of distinct latency, adjacent
+ * packets take different-delay paths and overtake each other, so the stream
+ * arrives maximally interleaved. The resequencer restores order at the far
+ * end; on the wire no link carries an ordered subsequence. This is the
+ * "leave completely out of order, reconstruct on arrival" egress mode. */
 static struct mud_path *
-mud_select_path(struct mud *mud, uint16_t cursor)
+mud_select_path_scatter(struct mud *mud)
 {
+    struct mud_path *running[MUD_PATH_MAX];
+    unsigned count = 0;
+
+    uint64_t min_owd = UINT64_MAX;
+
+    for (unsigned i = 0; i < mud->capacity; i++) {
+        struct mud_path *path = &mud->paths[i];
+        if (path->status == MUD_RUNNING && path->tx.rate) {
+            running[count++] = path;
+            uint64_t owd = path->rtt.val / 2;
+            if (path->rtt.val && owd < min_owd)
+                min_owd = owd;
+        }
+    }
+    if (!count)
+        return NULL;
+
+    /* Black Relay: only scatter onto lanes the far end's resequencer can
+     * wait for. A lane whose one-way delay trails the fastest by more than
+     * the budget (a Starlink handoff, a congested cell) would deliver after
+     * the hold expires, so its packets would just be lost. Skip it until it
+     * recovers; the fastest lane always qualifies. */
+    if (mud->scatter_budget && min_owd != UINT64_MAX) {
+        unsigned kept = 0;
+        for (unsigned i = 0; i < count; i++) {
+            uint64_t owd = running[i]->rtt.val / 2;
+            if (!running[i]->rtt.val || owd <= min_owd + mud->scatter_budget)
+                running[kept++] = running[i];
+        }
+        count = kept;
+    }
+    return running[mud->scatter_rr++ % count];
+}
