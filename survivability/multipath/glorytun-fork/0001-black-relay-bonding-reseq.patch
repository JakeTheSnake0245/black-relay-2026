+/* Black Relay: closed-loop adaptive FEC.
+ *
+ * The sender already learns forward loss per path from the stat exchange
+ * (path->tx.loss, 0-255). Aggregate it (rate-weighted over running paths)
+ * and pick the group size N: more loss -> smaller N (more parity, more
+ * recovery); less loss -> larger N (less overhead). XOR recovers one loss
+ * per group, so target roughly one parity per expected loss. Rate-limited
+ * to once a second; takes effect at the next group boundary. */
+static void
+mud_fec_adapt(struct mud *mud, uint64_t now)
+{
+    if (!mud->fec_on || !mud->fec_adapt)
+        return;
+    if (now - mud->fec_adapt_time < MUD_ONE_SEC)
+        return;
+    mud->fec_adapt_time = now;
+
+    uint64_t num = 0, den = 0;
+    for (unsigned i = 0; i < mud->capacity; i++) {
+        struct mud_path *path = &mud->paths[i];
+        if (path->status != MUD_RUNNING || !path->tx.rate)
+            continue;
+        num += (uint64_t)path->tx.loss * path->tx.rate;
+        den += path->tx.rate;
+    }
+    if (!den)
+        return;
+
+    unsigned loss255 = (unsigned)(num / den);        /* 0-255 */
+    unsigned pct_x10 = loss255 * 1000U / 255U;        /* tenths of a percent */
+
+    unsigned n;
+    if      (pct_x10 <  5) n = 32;   /* < 0.5% */
+    else if (pct_x10 < 10) n = 16;   /* < 1%   */
+    else if (pct_x10 < 30) n = 8;    /* < 3%   */
+    else if (pct_x10 < 60) n = 4;    /* < 6%   */
+    else                    n = 2;   /* >= 6%  */
+
+    fec_enc_set_n(&mud->fec_enc, n);
 }
 
