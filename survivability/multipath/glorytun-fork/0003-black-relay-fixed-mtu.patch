+/* Black Relay: fixed tunnel MTU (the size mud_get_mtu() reports). For paths
+ * carried over a stream transport (WebSocket/TLS lanes) there is no path MTU:
+ * probing only measures loss, and one lossy path would hold the whole tunnel
+ * at the MUD_MTU_MIN floor, since the tunnel takes the smallest path MTU. */
+int
+mud_set_fixed_mtu(struct mud *mud, size_t mtu)
+{
+    size_t wire = mtu + MUD_PKT_MIN_SIZE + MUD_SEQ_SIZE;
+
+    if (wire < MUD_MTU_MIN || wire > MUD_MTU_MAX) {
+        errno = EINVAL;
+        return -1;
+    }
+    mud->fixed_mtu = wire;
     return 0;
 }
 
